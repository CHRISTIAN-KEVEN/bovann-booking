# Copy to apps/web/.env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SPACE_SLUG=studio-principal-lome

# Shows "simulate payment" buttons on the payment screen. Development and demos only:
# must match the API running with PAYMENT_PROVIDER=mock.
NEXT_PUBLIC_PAYMENT_SIMULATION=true

# Optional Cloudflare Turnstile bot check (set the matching secret on the API).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
