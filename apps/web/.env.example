# Copy to apps/web/.env.local for local development.
# Leave empty: the site calls /api on its own address and forwards it to the API.
NEXT_PUBLIC_API_URL=
# Where the site forwards /api (server side). Default http://localhost:3001.
API_PROXY_TARGET=http://localhost:3001
# Extra host names allowed to use the dev server (tunnels). Default: ngrok addresses.
# DEV_ALLOWED_ORIGINS=*.ngrok-free.app,*.ngrok-free.dev
NEXT_PUBLIC_SPACE_SLUG=studio-principal-lome

# Shows "simulate payment" buttons on the payment screen. Development and demos only:
# must match the API running with PAYMENT_PROVIDER=mock.
NEXT_PUBLIC_PAYMENT_SIMULATION=true

# Optional Cloudflare Turnstile bot check (set the matching secret on the API).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Studio phone / WhatsApp shown on the conditions page (optional), e.g. +228 90 00 00 00
NEXT_PUBLIC_STUDIO_CONTACT_PHONE=
