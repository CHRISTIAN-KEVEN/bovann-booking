{
  "name": "@bovann/web",
  "version": "0.1.0",
  "private": true,
  "description": "Bovann customer booking site and admin (Next.js)",
  "scripts": {
    "dev": "pnpm --filter @bovann/shared build && next dev --port 3000",
    "build": "pnpm --filter @bovann/shared build && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bovann/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
