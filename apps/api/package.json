{
  "name": "@bovann/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bovann booking REST API (NestJS + MySQL)",
  "scripts": {
    "build": "pnpm --filter @bovann/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm --filter @bovann/shared build && tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch-path=dist dist/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/cli.ts latest",
    "db:rollback": "tsx --env-file-if-exists=.env src/database/cli.ts down",
    "db:reset": "tsx --env-file-if-exists=.env src/database/cli.ts reset",
    "db:status": "tsx --env-file-if-exists=.env src/database/cli.ts status",
    "db:seed": "tsx --env-file-if-exists=.env src/database/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/admin/create-admin.ts"
  },
  "dependencies": {
    "@bovann/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "kysely": "^0.28.19",
    "mysql2": "^3.24.6",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
