# Copy to apps/api/.env for local development. Never commit the real .env.
NODE_ENV=development
# Production builds only: `staging` allows simulated payments and codes; unset = production.
# DEPLOY_ENV=staging
PORT=3001
LOG_LEVEL=info
DATABASE_URL=mysql://bovann:bovann_dev@127.0.0.1:3306/bovann
DATABASE_POOL_SIZE=10
CORS_ORIGINS=http://localhost:3000

# Integration tests: a DISPOSABLE database, it is wiped on every run.
DATABASE_URL_TEST=mysql://bovann:bovann_dev@127.0.0.1:3306/bovann_test

# Optional, used by `pnpm db:seed`: comma-separated owner emails notified of confirmed bookings.
SEED_OWNER_EMAILS=

# Admin sign-in attempts per connection per minute (accounts also lock after 5 wrong passwords).
ADMIN_LOGIN_RATE_LIMIT_PER_MIN=10
# The admin session cookie is HTTPS-only in production. Set to false only to try a
# production build over plain HTTP on your own machine.
# ADMIN_COOKIE_SECURE=false

# --- Emails (Phase 6) ---------------------------------------------------------
# Development: Mailpit (infra/docker-compose.dev.yml) catches every email at
# http://localhost:8025, nothing reaches real inboxes.
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM="Bovann OCD Live <reservations@example.com>"
PUBLIC_WEB_URL=http://localhost:3000
# STUDIO_CONTACT_PHONE="+228 90 00 00 00"
#
# Real sending with Gmail (free, 500 emails/day): turn on 2-Step Verification on
# the Google account, create an App Password, then use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=<your Gmail address>
#   SMTP_PASSWORD=<the 16-character App Password>
# Later, with Bovann's own domain: Brevo (free, 300/day), smtp-relay.brevo.com:587.

# "Mes réservations" lookups (reference + phone) per minute per connection
LOOKUP_RATE_LIMIT_PER_MIN=10

# Number of proxies in front of the API whose X-Forwarded-For to trust, so rate limits apply per visitor.
# 1 when the website forwards /api (ngrok -> website -> API); 0 when the API is reached directly.
TRUST_PROXY_HOPS=1

# --- Seller sign-in codes (live directory) -------------------------------------
# simulated: the code is shown on the sign-in screen and in the API log (development only).
# disabled: seller sign-in closed (production until Bovann chooses a WhatsApp/SMS provider).
OTP_TRANSPORT=simulated
# Key used to hash codes; required in production once codes are really sent.
# Generate one with: openssl rand -base64 48
# OTP_SECRET=
OTP_RATE_LIMIT_PER_HOUR=20
