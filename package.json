{
  "name": "bovann-booking",
  "private": true,
  "description": "Bovann OCD Live — booking system for live-stream studio slots",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @bovann/api dev",
    "dev:web": "pnpm --filter @bovann/web dev",
    "db:migrate": "pnpm --filter @bovann/api db:migrate",
    "db:rollback": "pnpm --filter @bovann/api db:rollback",
    "db:seed": "pnpm --filter @bovann/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
